# Format: long-random-key:tenant-id:role1|role2
RENWORK_API_KEYS=replace-with-at-least-32-random-characters:demo-export:admin|sales
RENWORK_CORS_ORIGINS=http://localhost:8080
RENWORK_TENANT_ID=demo-export
RENWORK_EXPORT_API_URL=http://localhost:8080
# Keep the key in your private environment; never commit a real value.
RENWORK_EXPORT_API_KEY=replace-with-the-same-private-key
