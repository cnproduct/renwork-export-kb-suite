{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rrenn.com/schemas/knowledge-card-v4.json",
  "title": "RenWork Knowledge Card V4",
  "type": "object",
  "additionalProperties": false,
  "required": ["kb_id","tenant_id","revision","module","knowledge_kind","entity_type","entity_id","title","language","status","confidence","confidence_basis","sensitivity","public_claim_approved","role_views","conclusion","conditions","source_refs","recommended_actions","red_lines","pending_confirmations","created_at","updated_at"],
  "properties": {
    "kb_id":{"type":"string","pattern":"^RW-[A-Z0-9]{6}-[0-9]{4,6}$"},
    "tenant_id":{"type":"string","minLength":2,"maxLength":80},
    "revision":{"type":"integer","minimum":1},
    "module":{"type":"string","pattern":"^(0[0-9]|1[0-9]|20)_[a-z0-9_]+$"},
    "knowledge_kind":{"enum":["fact","rule","workflow","template","case_study","training_material"]},
    "entity_type":{"type":"string"},"entity_id":{"type":"string"},"title":{"type":"string"},"language":{"type":"string"},
    "status":{"enum":["verified_fact","public_fact","ai_inference","strategy_recommendation","pending_supplement","deprecated","conflicted"]},
    "confidence":{"type":"number","minimum":0,"maximum":1},"confidence_basis":{"type":"string"},
    "sensitivity":{"enum":["public","internal","restricted"]},"public_claim_approved":{"type":"boolean"},
    "role_views":{"type":"array","uniqueItems":true,"items":{"enum":["management","sales_director","junior_sales","senior_sales","marketing","operations_quality"]}},
    "applicable_markets":{"type":"array","items":{"type":"string"}},"applicable_buyer_types":{"type":"array","items":{"type":"string"}},"workflow_stages":{"type":"array","items":{"type":"string"}},
    "conclusion":{"type":"string"},"conditions":{"type":"string"},
    "source_refs":{"type":"array","items":{"type":"object","required":["type","captured_at","authority"],"properties":{"type":{"enum":["user_supplied","official_website","official_document","crm","public_registry","third_party","ai_inference"]},"uri":{"type":"string"},"captured_at":{"type":"string","format":"date-time"},"locator":{"type":"string"},"excerpt":{"type":"string"},"authority":{"enum":["S","A","B","C","D","I"]}}}},
    "recommended_actions":{"type":"string"},"red_lines":{"type":"string"},"pending_confirmations":{"type":"string"},
    "verified_by":{"type":["string","null"]},"verified_at":{"type":["string","null"]},"valid_until":{"type":["string","null"]},
    "created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}
  }
}
