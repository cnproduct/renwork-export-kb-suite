{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RenWorkKnowledgeCardV3",
  "description": "Standard schema for RenWork export enterprise knowledge card V3.0",
  "type": "object",
  "required": [
    "kb_id",
    "tenant_id",
    "module",
    "knowledge_kind",
    "entity_type",
    "entity_id",
    "title",
    "language",
    "status",
    "confidence",
    "sensitivity",
    "public_claim_approved",
    "role_views",
    "conclusion",
    "conditions",
    "evidence",
    "recommended_actions",
    "red_lines",
    "pending_confirmations"
  ],
  "properties": {
    "kb_id": {
      "type": "string",
      "pattern": "^NK-[A-Z]{3,6}-[0-9]{4,6}$",
      "description": "Unique knowledge card identifier (e.g. NK-PROD-0001, NK-GOV-0002)"
    },
    "tenant_id": {
      "type": "string",
      "description": "Enterprise tenant unique ID for data isolation"
    },
    "module": {
      "type": "string",
      "enum": [
        "00_kb_governance",
        "01_sources_permissions",
        "02_company_identity",
        "03_brand_messaging",
        "04_product_catalog",
        "05_manufacturing_quality",
        "06_certification_compliance",
        "07_commercial_delivery",
        "08_market_intelligence",
        "09_icp_buyer_personas",
        "10_buyer_intent_signals",
        "11_competitors_differentiation",
        "12_product_market_fit",
        "13_lead_discovery",
        "14_customer_asset_lifecycle",
        "15_inquiry_qualification",
        "16_solution_quotation",
        "17_objection_negotiation",
        "18_sales_content_templates",
        "19_order_delivery_aftersales",
        "20_learning_metrics"
      ]
    },
    "knowledge_kind": {
      "type": "string",
      "enum": ["fact", "rule", "workflow", "template", "case_study", "training_material"]
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "company",
        "brand",
        "product",
        "market",
        "buyer_persona",
        "account",
        "contact",
        "opportunity",
        "policy",
        "sop",
        "glossary",
        "metric"
      ]
    },
    "entity_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "default": "zh-CN"
    },
    "status": {
      "type": "string",
      "enum": [
        "verified_fact",
        "public_fact",
        "ai_inference",
        "strategy_recommendation",
        "pending_supplement",
        "deprecated"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "sensitivity": {
      "type": "string",
      "enum": ["public", "internal", "restricted"]
    },
    "public_claim_approved": {
      "type": "boolean",
      "default": false
    },
    "role_views": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "management",
          "sales_director",
          "junior_sales",
          "senior_sales",
          "marketing",
          "operations_quality"
        ]
      }
    },
    "applicable_markets": {
      "type": "array",
      "items": { "type": "string" }
    },
    "applicable_buyer_types": {
      "type": "array",
      "items": { "type": "string" }
    },
    "workflow_stages": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "discovery",
          "qualification",
          "quotation",
          "sample",
          "negotiation",
          "order_execution",
          "aftersales",
          "repeat_purchase"
        ]
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "captured_at"],
        "properties": {
          "type": { "type": "string" },
          "url": { "type": "string" },
          "file_name": { "type": "string" },
          "captured_at": { "type": "string" },
          "evidence_level": { "type": "string", "enum": ["S", "A", "B", "C", "D", "I"] }
        }
      }
    },
    "conclusion": {
      "type": "string",
      "description": "Shortest applicable answer / core fact"
    },
    "conditions": {
      "type": "string",
      "description": "Applicability conditions (markets, prerequisites, buyer profiles)"
    },
    "evidence": {
      "type": "string",
      "description": "Detailed source evidence supporting the conclusion"
    },
    "recommended_actions": {
      "type": "string",
      "description": "Next actionable steps when this scenario is matched"
    },
    "red_lines": {
      "type": "string",
      "description": "Non-negotiable boundaries, prohibited claims, or escalation triggers"
    },
    "pending_confirmations": {
      "type": "string",
      "description": "Missing, conflicting, or unverified information requiring human approval"
    }
  }
}
