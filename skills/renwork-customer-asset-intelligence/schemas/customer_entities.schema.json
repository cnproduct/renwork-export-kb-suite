{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RenWorkCustomerEntitiesV3",
  "description": "JSON Schemas for 8 Core Customer Entities conforming to Export KB V3.0",
  "definitions": {
    "Account": {
      "type": "object",
      "required": ["account_id", "standard_name", "domain", "country", "tier", "priority_score"],
      "properties": {
        "account_id": { "type": "string" },
        "standard_name": { "type": "string" },
        "brand_name": { "type": "string" },
        "domain": { "type": "string" },
        "country": { "type": "string" },
        "language": { "type": "string" },
        "timezone": { "type": "string" },
        "buyer_type": { "type": "string", "enum": ["brand_owner", "importer", "distributor", "retailer", "contractor", "ecom_seller"] },
        "icp_fit_level": { "type": "string", "enum": ["A+", "A", "B", "C"] },
        "tier": { "type": "string", "enum": ["S", "A", "B", "C", "D"] },
        "priority_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "score_breakdown": {
          "type": "object",
          "properties": {
            "intent": { "type": "number" },
            "fit": { "type": "number" },
            "power": { "type": "number" },
            "stage": { "type": "number" },
            "value": { "type": "number" },
            "quality": { "type": "number" },
            "risk_penalty": { "type": "number" }
          }
        },
        "assigned_rep": { "type": "string" },
        "total_revenue_usd": { "type": "number", "default": 0 },
        "historical_orders_count": { "type": "integer", "default": 0 },
        "average_repurchase_cycle_days": { "type": "integer" },
        "last_order_date": { "type": "string" },
        "next_predicted_order_window": { "type": "string" },
        "last_interaction_at": { "type": "string" },
        "consent_status": { "type": "string", "enum": ["subscribed", "opt_out", "unsubscribed", "blacklisted", "dispute"] },
        "risk_flags": { "type": "array", "items": { "type": "string" } },
        "dynamic_lists": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Contact": {
      "type": "object",
      "required": ["contact_id", "account_id", "full_name", "email"],
      "properties": {
        "contact_id": { "type": "string" },
        "account_id": { "type": "string" },
        "full_name": { "type": "string" },
        "title": { "type": "string" },
        "role_in_buying_committee": {
          "type": "string",
          "enum": ["economic_buyer", "technical_evaluator", "user_influencer", "procurement_gatekeeper", "champion", "blocker"]
        },
        "email": { "type": "string", "format": "email" },
        "email_verification_status": { "type": "string", "enum": ["C1_verified", "C2_pattern_matched", "C0_risky", "bounced"] },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "linkedin_url": { "type": "string" },
        "is_primary": { "type": "boolean", "default": false }
      }
    },
    "Opportunity": {
      "type": "object",
      "required": ["opportunity_id", "account_id", "stage", "estimated_amount_usd"],
      "properties": {
        "opportunity_id": { "type": "string" },
        "account_id": { "type": "string" },
        "title": { "type": "string" },
        "stage": {
          "type": "string",
          "enum": ["discovery", "rfq_received", "quote_sent", "sample_testing", "commercial_negotiation", "pi_issued", "closed_won", "closed_lost"]
        },
        "estimated_amount_usd": { "type": "number" },
        "probability_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "stage_entered_at": { "type": "string" },
        "next_action_due_at": { "type": "string" },
        "loss_reason": { "type": "string" }
      }
    },
    "Interaction": {
      "type": "object",
      "required": ["interaction_id", "account_id", "channel", "signal_strength", "timestamp"],
      "properties": {
        "interaction_id": { "type": "string" },
        "account_id": { "type": "string" },
        "contact_id": { "type": "string" },
        "channel": { "type": "string", "enum": ["email", "whatsapp", "linkedin", "phone", "video_call", "rfq", "website", "exhibition"] },
        "signal_type": { "type": "string", "enum": ["inquiry", "quote_request", "sample_feedback", "complaint", "click", "open", "unsubscribe"] },
        "signal_strength": { "type": "string", "enum": ["strong", "medium", "weak", "negative"] },
        "summary": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    },
    "Transaction": {
      "type": "object",
      "required": ["transaction_id", "account_id", "order_date", "amount_usd"],
      "properties": {
        "transaction_id": { "type": "string" },
        "account_id": { "type": "string" },
        "order_type": { "type": "string", "enum": ["sample", "trial_order", "repeat_order", "annual_contract"] },
        "order_date": { "type": "string" },
        "amount_usd": { "type": "number" },
        "sku_list": { "type": "array", "items": { "type": "string" } },
        "gross_margin_percent": { "type": "number" },
        "payment_terms": { "type": "string" },
        "status": { "type": "string", "enum": ["in_production", "shipped", "delivered", "settled", "disputed"] }
      }
    },
    "ProductInterest": {
      "type": "object",
      "required": ["interest_id", "account_id", "product_id"],
      "properties": {
        "interest_id": { "type": "string" },
        "account_id": { "type": "string" },
        "product_id": { "type": "string" },
        "customization_depth": { "type": "string", "enum": ["standard", "light_custom", "odm", "oem_tooling"] },
        "target_moq": { "type": "integer" }
      }
    },
    "Task": {
      "type": "object",
      "required": ["task_id", "account_id", "action_type", "due_date", "assignee"],
      "properties": {
        "task_id": { "type": "string" },
        "account_id": { "type": "string" },
        "action_type": { "type": "string", "enum": ["call", "1v1_email", "quote_revision", "sample_followup", "manager_escalation", "nurture"] },
        "description": { "type": "string" },
        "due_date": { "type": "string" },
        "assignee": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "in_progress", "completed", "overdue", "cancelled"] }
      }
    },
    "RiskConsent": {
      "type": "object",
      "required": ["account_id", "consent_status", "is_hard_stop"],
      "properties": {
        "account_id": { "type": "string" },
        "consent_status": { "type": "string", "enum": ["subscribed", "opt_out", "unsubscribed", "blacklisted", "disputed_debt"] },
        "is_hard_stop": { "type": "boolean" },
        "reason": { "type": "string" },
        "recorded_at": { "type": "string" }
      }
    }
  }
}
