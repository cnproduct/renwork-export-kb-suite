{
  "name": "renwork-export-kb-suite",
  "version": "4.0.0",
  "description": "RenWork AI 外贸增长系统 V4：证据优先、租户隔离、公开发布闸门、8类客户实体、可解释评分、8类动态名单、询盘与条件报价。未配置实时连接器时明确拒绝模拟数据。",
  "author": {
    "name": "人人易 AI (Renrenyi AI)",
    "email": "support@rrenn.com",
    "website": "https://rrenn.com"
  },
  "license": "MIT",
  "repository": "https://github.com/cnproduct/renwork-export-kb-suite",
  "keywords": [
    "renwork",
    "export-kb",
    "b2b-export",
    "knowledge-base-v4",
    "customer-asset-360",
    "dynamic-scoring",
    "sales-execution",
    "mcp-server",
    "cloud-api",
    "six-role-views"
  ],
  "mcp_servers": {
    "export-kb-mcp": {
      "command": "node",
      "args": ["mcp/export-kb-mcp/dist/index.js"]
    }
  },
  "skills": [
    "skills/renwork-export-kb-orchestrator",
    "skills/renwork-customer-asset-intelligence",
    "skills/renwork-export-sales-execution",
    "skills/renwork-industry-kb-adapter",
    "skills/renwork-kb-governance-auditor",
    ".opencode/skills/renwork-ai-export-growth-system"
  ],
  "opencode_plugin": ".opencode/plugins/renwork-export-growth.ts",
  "configuration": {
    "required_environment": ["RENWORK_TENANT_ID"],
    "optional_environment": ["RENWORK_EXPORT_API_URL", "RENWORK_EXPORT_API_KEY"]
  }
}
